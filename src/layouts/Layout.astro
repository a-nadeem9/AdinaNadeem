---
import Header from '../components/Header.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Adina Nadeem - Bioinformatics MSc | Biological Representation Learning',
  description = 'Portfolio of Adina Nadeem, an MSc Bioinformatics student interested in biological representation learning, protein language models, and reproducible machine learning for biology.',
  ogImage = '/adina-profile.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="Adina Nadeem, bioinformatics, biological foundation models, protein language models, representation learning, computational biology, Freie Universität Berlin" />
  <meta name="author" content="Adina Nadeem" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png?v=6" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=6" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=6" />
  <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=6" />
  <link rel="manifest" href="/site.webmanifest?v=6" />
  <title>{title}</title>

  <script is:inline>
    (function() {
      var stored = localStorage.getItem('theme');
      if (stored === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <ClientRouter />
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"></div>
  <Header />

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-content">
      <p>
        &copy; {new Date().getFullYear()} Adina Nadeem
        <span aria-hidden="true">/</span>
        <a href="https://github.com/a-nadeem9" target="_blank" rel="noopener" class="footer-link">GitHub</a>
        <span aria-hidden="true">/</span>
        <a href="mailto:adinanadeem@gmail.com" class="footer-link">Email</a>
      </p>
    </div>
  </footer>

  <script is:inline>
    document.addEventListener('astro:before-swap', function(e) {
      var isDark = document.documentElement.classList.contains('dark');
      if (isDark) e.newDocument.documentElement.classList.add('dark');
      else e.newDocument.documentElement.classList.remove('dark');
    });
  </script>

  <script>
    function initAnimations() {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.animationDelay = `${i * 55}ms`;
            el.classList.add('animate-fade-up');
            el.classList.remove('will-animate');
            obs.unobserve(el);
          }
        });
      }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });
      document.querySelectorAll('.will-animate').forEach(el => obs.observe(el));
    }
    initAnimations();
    document.addEventListener('astro:page-load', initAnimations);
  </script>

  <script is:inline>
    function initScrollProgress() {
      var bar = document.querySelector('.scroll-progress');
      if (!bar) return;

      function updateProgress() {
        var doc = document.documentElement;
        var scrollable = doc.scrollHeight - window.innerHeight;
        var progress = scrollable > 0 ? (window.scrollY / scrollable) : 0;
        bar.style.transform = 'scaleX(' + Math.min(1, Math.max(0, progress)) + ')';
      }

      updateProgress();
      window.removeEventListener('scroll', updateProgress);
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.removeEventListener('resize', updateProgress);
      window.addEventListener('resize', updateProgress);
      document.addEventListener('astro:page-load', updateProgress, { once: true });
    }

    initScrollProgress();
    document.addEventListener('astro:page-load', initScrollProgress);
  </script>

  <script is:inline>
    function visitorMapHasRendered(shell) {
      return Boolean(shell.querySelector(
        '#mapmyvisitors-widget, .clustrmaps-map, .clustrmaps-map-container, canvas, svg, iframe, img, a'
      ));
    }

    function initVisitorMap() {
      var section = document.querySelector('[data-visitor-map-src]');
      if (!section) return;

      var shell = document.getElementById('visitor-map-shell');
      if (!shell || shell.getAttribute('data-map-monitoring') === 'true') return;

      section.hidden = false;
      shell.setAttribute('data-map-monitoring', 'true');

      var attempts = 0;
      var renderCheck = window.setInterval(function() {
        attempts += 1;

        if (visitorMapHasRendered(shell)) {
          window.clearInterval(renderCheck);
          shell.removeAttribute('data-map-monitoring');
          return;
        }

        if (attempts >= 24) {
          window.clearInterval(renderCheck);
          shell.removeAttribute('data-map-monitoring');
          section.hidden = true;
        }
      }, 250);
    }

    initVisitorMap();
    document.addEventListener('astro:page-load', initVisitorMap);
    document.addEventListener('astro:after-swap', initVisitorMap);
  </script>
</body>
</html>

<style>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 300;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
  #main-content {
    padding-top: 0;
    padding-bottom: 3rem;
    min-height: calc(100vh - var(--header-height));
  }
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    background: var(--color-bg);
    width: 100%;
  }
  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.35rem 2rem;
    font-family: var(--font-heading);
    font-size: 0.86rem;
  }
  .footer-content p {
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .footer-content span {
    color: var(--color-border);
    padding: 0 0.35rem;
  }
  .footer-link {
    color: var(--color-accent);
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--color-secondary); }
  @media (max-width: 700px) {
    .footer-content {
      flex-direction: column;
      align-items: flex-start;
      padding-inline: 1.2rem;
    }
  }
</style>
