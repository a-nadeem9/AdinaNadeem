---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
}
const { title, description, tags = [], github, demo } = Astro.props;
---

<article class="proj-card will-animate">
  <h3 class="proj-title">{title}</h3>
  <p class="proj-desc">{description}</p>
  {tags.length > 0 && (
    <div class="proj-tags">
      {tags.map(t => <span class="tag">{t}</span>)}
    </div>
  )}
  {(github || demo) && (
    <div class="proj-btns">
      {github && <a href={github} target="_blank" rel="noopener" class="pub-btn">GitHub</a>}
      {demo && <a href={demo} target="_blank" rel="noopener" class="pub-btn">Live Demo</a>}
    </div>
  )}
</article>

<style>
.proj-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 4px;
  padding: 1.25rem 1.35rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: none;
  transition: border-color 0.2s;
}
.proj-card:hover {
  border-color: var(--color-border);
  background: var(--color-surface);
  transform: none;
}
.proj-title {
  font-family: var(--font-heading);
  font-size: 1.12rem;
  font-weight: 650;
  line-height: 1.3;
}
.proj-desc {
  font-size: 0.96rem;
  color: var(--color-muted);
  line-height: 1.7;
}
.proj-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem 0.7rem;
}
.proj-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: auto;
}
.pub-btn {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-accent);
  border: none;
  border-bottom: 1px solid currentColor;
  padding: 0;
  border-radius: 0;
  background: transparent;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
  text-decoration: none;
}
.pub-btn:hover {
  background: transparent;
  color: var(--color-accent2);
  border-color: currentColor;
}
</style>
