---
import Layout from '../layouts/Layout.astro';
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/a-nadeem9', icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/adinanadeem/', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:adinanadeem@gmail.com', icon: 'mail' },
  { label: 'Resume', href: '/journey', icon: 'file' },
];

const affiliations = [
  {
    name: 'Freie Universität Berlin',
    href: 'https://www.fu-berlin.de/',
    logo: '/affiliations/fu-berlin-clean.png',
  },
  {
    name: 'Charité',
    href: 'https://www.charite.de/',
    logo: '/affiliations/charite-clean.png',
  },
  {
    name: 'Max Planck Institute for Infection Biology',
    href: 'https://www.mpiib-berlin.mpg.de/en',
    logo: '/affiliations/mpiib-clean.png',
  },
];

const timelineItems = [
  {
    date: 'October 2025',
    text: 'Selected for a Charité X-Student Research Group using machine learning to study individual immune responses across immunological, clinical, and genetic data.',
  },
  {
    date: 'September 2025',
    text: 'Joined the Max Planck Institute for Infection Biology as a Bioinformatics Student Assistant.',
  },
  {
    date: 'October 2024',
    text: 'Relocated to Berlin to begin my M.Sc. in Bioinformatics at Freie Universität Berlin.',
  },
  {
    date: 'May 2024',
    text: 'Submitted a Google Summer of Code proposal for a Nextflow pipeline tackling multiple-mapping in pathogen genomics, following discussions with a Wellcome Sanger Institute mentor.',
  },
  {
    date: 'April 2024',
    text: 'Advanced to the interview stage of the Major League Hacking (MLH) Fellowship.',
  },
];

const defaultMapMyVisitorsKey = 'iyHOuSXOuyzJU7Wg20gI3dp8vVRLSMxuGfvfe03TqWo';
const mapMyVisitorsKey = import.meta.env.PUBLIC_MAPMYVISITORS_KEY || defaultMapMyVisitorsKey;
const visitorMapEmbedSrc = import.meta.env.PUBLIC_VISITOR_MAP_EMBED_SRC || '';
const mapMyVisitorsSrc = `https://mapmyvisitors.com/map.js?cl=ffffff&w=792&t=n&d=${encodeURIComponent(mapMyVisitorsKey)}`;
const visitorMapSrc = visitorMapEmbedSrc || mapMyVisitorsSrc;

---

<Layout
  title="Adina Nadeem - Bioinformatics MSc"
  description="Portfolio of Adina Nadeem, an MSc Bioinformatics student interested in biological representation learning, machine learning for complex biological data, and reproducible research."
  homeHeader={true}
>
  <div class="container profile-page">
    <section class="intro" aria-labelledby="profile-name">
      <div class="intro-grid">
        <div class="intro-copy">
          <aside class="intro-aside" aria-label="Profile details">
            <img src="/adina-profile.jpg" alt="Adina Nadeem" class="intro-photo" loading="eager" />
            <h1 id="profile-name" class="profile-name">Adina Nadeem</h1>
            <p class="profile-role">MSc Bioinformatics student<br />Berlin, Germany</p>

            <div class="social-row" aria-label="Profile links">
              {socialLinks.map(link => (
                <a href={link.href} class="social-link" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                  <span class="social-icon" aria-hidden="true">
                    {link.icon === 'github' && (
                      <svg viewBox="0 0 24 24" role="img">
                        <path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.22-3.37-1.22-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.71 0 0 .84-.27 2.75 1.05A9.34 9.34 0 0 1 12 6.94c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.05 2.74-1.05.55 1.4.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.1 10.1 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z" />
                      </svg>
                    )}
                    {link.icon === 'linkedin' && (
                      <svg viewBox="0 0 24 24" role="img">
                        <path d="M5.2 8.8H2.4V21h2.8V8.8ZM3.8 3C2.8 3 2 3.78 2 4.75S2.78 6.5 3.76 6.5h.02c1.02 0 1.8-.78 1.8-1.75S4.8 3 3.8 3Zm7 5.8H8V21h2.8v-6.78c0-.36.03-.72.13-.98.3-.72.98-1.47 2.12-1.47 1.5 0 2.1 1.13 2.1 2.8V21H18v-6.75c0-3.62-1.93-5.3-4.5-5.3-2.1 0-3.02 1.16-3.53 1.97h.03V8.8Z" />
                      </svg>
                    )}
                    {link.icon === 'mail' && (
                      <svg viewBox="0 0 24 24" role="img">
                        <path d="M3.5 5h17A1.5 1.5 0 0 1 22 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 17.5v-11A1.5 1.5 0 0 1 3.5 5Zm.7 2 7.8 5.45L19.8 7H4.2Zm15.8 1.85-7.43 5.19a1 1 0 0 1-1.14 0L4 8.85V17h16V8.85Z" />
                      </svg>
                    )}
                    {link.icon === 'file' && (
                      <svg viewBox="0 0 24 24" role="img">
                        <path d="M6 2.5h8.3L20 8.2v13.3H6V2.5Zm7.5 1.8V9h4.7l-4.7-4.7ZM8 4.5v15h10V11h-6.5V4.5H8Zm2 8.5h6v1.7h-6V13Zm0 3.3h6v1.7h-6v-1.7Z" />
                      </svg>
                    )}
                  </span>
                  {link.label}
                </a>
              ))}
            </div>
          </aside>

          <div class="interest-block">
            <div class="bio-copy">
              <p>
                I'm currently an <strong>MSc Bioinformatics student at Freie Universität Berlin</strong>.
              </p>
              <p>
                I’m particularly curious about <strong>representation learning</strong>. Our biological operating system is highly malleable,
                adaptive, context-dependent, and constantly changing. I’m curious whether models can help us find structure within that
                flexibility and uncover patterns we would not have known to look for.
              </p>
              <p>
                At the <strong>Max Planck Institute for Infection Biology</strong>, I work on malaria genomics, conducting single-cell analyses,
                and analysing amplicon-sequencing data to study malaria transmission dynamics.
              </p>
              <p>
                I am also working on a project with <strong>protein language models</strong>, using evolutionary search to study how protein
                sequences navigate its learned representation landscape and whether different trajectories reveal reproducible patterns of
                convergence.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="affiliation-strip" aria-label="Affiliations">
        {affiliations.map(item => (
          <a
            href={item.href}
            class="affiliation-card"
            target="_blank"
            rel="noopener"
            aria-label={item.name}
          >
            <img
              src={item.logo}
              alt={item.name}
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </section>

    <section class="timeline-section" aria-labelledby="timeline-title">
      <h2 id="timeline-title">Timeline</h2>
      <div class="timeline-list">
        {timelineItems.map(item => (
          <article class="timeline-item">
            <time>{item.date}</time>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="visitor-map-section"
      aria-label="Recent visitor map"
      data-visitor-map-src={visitorMapSrc}
    >
      <div class="visitor-map-shell" id="visitor-map-shell">
        <script
          is:inline
          data-astro-rerun
          type="text/javascript"
          id="mapmyvisitors"
          src={visitorMapSrc}
        ></script>
      </div>
    </section>
  </div>
</Layout>

<style>
.profile-page {
  padding-top: 0;
}

.intro {
  padding: 2rem 0 0;
}

.intro-grid {
  max-width: 860px;
  margin-inline: auto;
}

.intro-copy {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  grid-template-rows: auto;
  column-gap: 2.5rem;
  align-items: start;
  min-width: 0;
}

.interest-block {
  grid-column: 2;
  grid-row: 1;
  margin: 0;
}

.bio-copy {
  display: grid;
  gap: 1.25rem;
  margin-top: 0;
}

.bio-copy p {
  margin: 0;
  color: var(--color-text);
  font-size: 0.96rem;
  line-height: 1.66;
}

.intro-aside {
  grid-column: 1;
  grid-row: 1;
  width: 100%;
  min-width: 0;
  margin: 0;
  text-align: left;
}

.intro-photo {
  display: block;
  width: 220px;
  max-width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  margin: 0 0 0.55rem;
  border-radius: 0;
  object-fit: cover;
  object-position: center 36%;
  border: 1px solid var(--color-border);
  box-shadow: none;
  filter: grayscale(1);
}

.profile-name {
  margin: 0 0 0.22rem;
  font-size: 1.2rem;
  font-weight: 700;
  line-height: 1.3;
}

.profile-role {
  margin: 0;
  color: var(--color-text);
  font-size: 0.95rem;
  line-height: 1.45;
}

.social-row {
  display: grid;
  justify-items: start;
  gap: 0.1rem;
  margin-top: 0.6rem;
}

.social-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  color: var(--color-accent);
  font-size: 0.91rem;
  font-weight: 500;
  line-height: 1.4;
}

.social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  width: 1rem;
  height: 1rem;
  flex: 0 0 auto;
}

.social-icon svg {
  width: 100%;
  height: 100%;
  display: block;
  fill: currentColor;
}

.social-link:hover,
.social-link:hover .social-icon {
  color: var(--color-accent2);
}

.affiliation-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.75rem;
  margin-top: 3rem;
  padding: 1rem 0 2.1rem;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.affiliation-card {
  display: grid;
  place-items: center;
  align-content: center;
  min-height: 116px;
  padding: 0.75rem;
  background: #ffffff;
  border: 1px solid #dddddd;
  border-radius: 4px;
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.dark .affiliation-card {
  background: #ffffff;
  border-color: #d8d8d8;
}

.affiliation-card:hover {
  border-color: var(--color-accent);
  transform: translateY(-1px);
}

.affiliation-card img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 88px;
  object-fit: contain;
}

.timeline-section {
  margin: 3rem 2rem 0;
  padding-top: 0;
}

.timeline-section h2 {
  margin-bottom: 1.55rem;
  font-size: clamp(1.55rem, 2.8vw, 2.15rem);
  font-weight: 500;
}

.timeline-list {
  position: relative;
  display: grid;
  gap: 1.35rem;
  padding-left: 1.65rem;
}

.timeline-list::before {
  content: '';
  position: absolute;
  top: 0.65rem;
  bottom: 0.65rem;
  left: 0.44rem;
  width: 2px;
  background: var(--color-border);
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: 1.3rem;
  align-items: baseline;
}

.timeline-item::before {
  content: '';
  position: absolute;
  top: 0.37rem;
  left: -1.65rem;
  width: 0.9rem;
  height: 0.9rem;
  border-radius: 50%;
  background: var(--color-accent);
  box-shadow: 0 0 0 5px var(--color-secondary-soft);
}

.timeline-item time {
  color: var(--color-text);
  font-size: 0.9rem;
  font-weight: 800;
  white-space: nowrap;
}

.timeline-item p {
  margin: 0;
  color: var(--color-text);
  font-size: 0.98rem;
  line-height: 1.58;
}

.timeline-item strong,
.timeline-item a {
  color: var(--color-accent);
}

.visitor-map-section {
  margin: 3rem 2rem 0;
  padding-top: 1.35rem;
  border-top: 1px solid var(--color-border);
}

.visitor-map-shell {
  position: relative;
  display: flex;
  justify-content: center;
  width: 100%;
}

.visitor-map-shell :global(canvas),
.visitor-map-shell :global(iframe),
.visitor-map-shell :global(img),
.visitor-map-shell :global(a) {
  max-width: 100%;
}

.visitor-map-shell :global(#mapmyvisitors-widget),
.visitor-map-shell :global(.clustrmaps-map),
.visitor-map-shell :global(.clustrmaps-map-container) {
  max-width: 100% !important;
  margin: 0 auto !important;
}

@media (max-width: 760px) {
  .intro-copy {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    gap: 0;
  }

  .intro-aside {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    max-width: 320px;
    margin-bottom: 2rem;
  }

  .interest-block {
    grid-column: 1;
    grid-row: 2;
  }
}

@media (max-width: 700px) {
  .affiliation-strip {
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  .timeline-item {
    grid-template-columns: 1fr;
    gap: 0.3rem;
  }
}

@media (max-width: 560px) {
  .intro {
    padding-inline: 0;
  }

  .timeline-section {
    margin-inline: 0;
  }

  .visitor-map-section {
    margin-inline: 0;
  }
}
</style>
