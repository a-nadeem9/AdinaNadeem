---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const skills = [
  'Python', 'R', 'Bash', 'SQL', 'Snakemake', 'Nextflow',
  'Docker', 'AWS', 'Git', 'RNA-seq', 'Genomics', 'Statistics',
  'DESeq2', 'Seurat', 'Biopython', 'SAMtools', 'BWA', 'BLAST',
];

const experience = [
  {
    period: 'Current',
    role: 'Bioinformatics / Data Work',
    org: 'Max Planck Institute for Infection Biology',
    bullets: [
      'Working in an infection biology research environment where computational analysis supports biological discovery.',
      'Focused on reproducible data workflows, genomics, and turning complex biomedical data into interpretable results.',
    ],
  },
  {
    period: 'Oct 2024 - Present',
    role: 'M.Sc. Bioinformatics',
    org: 'Freie Universitat Berlin',
    bullets: [
      'Specializing in data science, statistical analysis, genomics, and medical bioinformatics.',
      'Building toward research at the intersection of clinical, genomic, and computational data systems.',
    ],
  },
  {
    period: 'Aug 2022 - Feb 2023',
    role: 'Research Assistant',
    org: 'COMSATS University, Department of Biosciences',
    bullets: [
      'Built a Nextflow-based RNA-seq workflow to detect and filter polyadenylated reads from raw sequencing data.',
      'Analyzed large RNA sequencing datasets with Python and packaged the workflow in Docker for reproducibility.',
    ],
  },
];

const focusAreas = [
  {
    title: 'Genomics Workflows',
    text: 'Building and adapting RNA-seq, genome assembly, metagenomics, and transcript quantification pipelines.',
  },
  {
    title: 'Reproducible Analysis',
    text: 'Using Snakemake, Nextflow, Docker, Git, and structured reports to make computational work easier to rerun and review.',
  },
  {
    title: 'Biomedical Data',
    text: 'Working toward stronger analysis habits for biological, clinical, and multi-source datasets.',
  },
  {
    title: 'Infection Biology',
    text: 'Developing research experience in a Max Planck infection biology environment while strengthening genomics and programming skills.',
  },
];

const snapshots = [
  { label: 'Current', value: 'Max Planck Institute for Infection Biology' },
  { label: 'Program', value: 'MSc Bioinformatics, Freie Universitat Berlin' },
  { label: 'Core tools', value: 'Python, R, Snakemake, Nextflow, Docker' },
];

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter(project => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout
  title="Adina Nadeem - Bioinformatics MSc | Genomics Workflows"
  description="Portfolio of Adina Nadeem, an MSc Bioinformatics student focused on reproducible genomics workflows, statistical analysis, and biomedical data."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">MSc Bioinformatics - Berlin</p>
        <h1>Adina Nadeem</h1>
        <p class="hero-role">
          Bioinformatics MSc student focused on reproducible genomics workflows, statistical analysis,
          and biomedical data.
        </p>

        <div class="hero-actions">
          <a href="/adina_resume.pdf" target="_blank" rel="noopener" class="btn btn-solid">Download CV</a>
          <a href="https://github.com/a-nadeem9" target="_blank" rel="noopener" class="btn">GitHub</a>
          <a href="mailto:adinanadeem@gmail.com" class="btn">Email</a>
        </div>

        <div class="snapshot-grid">
          {snapshots.map(item => (
            <div class="snapshot-item">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
      </div>

      <div class="portrait-panel">
        <img src="/adina-profile.jpg" alt="Adina Nadeem" class="bio-photo" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div>
        <h2 class="section-title">About</h2>
      </div>
      <div class="bio-text">
        <p>
          I am an MSc Bioinformatics student at Freie Universitat Berlin, currently gaining research experience
          at the Max Planck Institute for Infection Biology. My work is centered on scientific programming,
          statistical analysis, and reproducible workflows for biological data.
        </p>
        <p>
          I have built RNA-seq and genomics workflows using tools such as Nextflow, Snakemake, Python, Bash,
          and Docker. I am most comfortable in the space between data cleaning, pipeline design, quality control,
          and communicating results clearly.
        </p>
        <p>
          Long term, I am interested in how genomic, clinical, and environmental data can be connected responsibly
          for precision medicine. For now, I am focused on building the technical and research foundation to do that
          work well.
        </p>
      </div>
    </div>
  </section>

  <section class="section focus-section">
    <div class="container project-preview">
      <div class="section-hdr">
        <h2 class="section-title">Selected Work</h2>
        <a href="/projects" class="more-link">View all projects</a>
      </div>
      <div class="preview-grid">
        {featuredProjects.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            github={project.data.github}
            demo={project.data.demo}
            featured={false}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section focus-section">
    <div class="container">
      <h2 class="section-title">Research Interests</h2>
      <div class="focus-grid">
        {focusAreas.map((area) => (
          <article class="focus-card will-animate">
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Skills &amp; Tools</h2>
      <div class="skills-wrap">
        {skills.map(s => <span class="tag">{s}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-hdr">
        <h2 class="section-title">Experience</h2>
        <a href="/journey" class="more-link">View full journey</a>
      </div>
      <div class="exp-list">
        {experience.map(e => (
          <article class="exp-card will-animate">
            <div class="exp-meta">
              <span class="exp-period">{e.period}</span>
            </div>
            <div class="exp-body">
              <h3 class="exp-role">{e.role}</h3>
              <p class="exp-org">{e.org}</p>
              <ul class="exp-bullets">
                {e.bullets.map(b => <li>{b}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.hero {
  padding: 3.6rem 0 3rem;
}
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 330px);
  gap: 4rem;
  align-items: center;
}
.hero-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.eyebrow {
  font-family: var(--font-sans);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin-bottom: 1rem;
}
.hero h1 {
  max-width: 780px;
}
.hero-role {
  max-width: 640px;
  margin-top: 0.85rem;
  font-size: clamp(1.08rem, 1.7vw, 1.3rem);
  color: var(--color-muted);
  font-weight: 450;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin: 1.65rem 0 2rem;
}
.snapshot-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.25rem;
  width: 100%;
  max-width: 640px;
  border-top: 1px solid var(--color-border);
  padding-top: 0.9rem;
}
.snapshot-item {
  display: grid;
  grid-template-columns: 95px 1fr;
  gap: 1rem;
  padding: 0.18rem 0;
  border-right: none;
}
.snapshot-item:last-child {
  padding-right: 0;
}
.snapshot-item:nth-child(2) {
  padding-left: 0;
}
.snapshot-item span {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 0.4rem;
}
.snapshot-item strong {
  display: block;
  font-family: var(--font-serif);
  font-size: 0.98rem;
  font-weight: 400;
  line-height: 1.35;
  color: var(--color-text);
}
.portrait-panel {
  position: relative;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  background: var(--color-surface);
  box-shadow: none;
  overflow: hidden;
}
.bio-photo {
  width: 100%;
  aspect-ratio: 4 / 5.15;
  display: block;
  object-fit: cover;
  object-position: center 42%;
  filter: contrast(1.05);
}
.about-grid {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: 2.5rem;
  border-top: 1px solid var(--color-border);
  padding-top: 3.25rem;
}
.bio-text {
  display: grid;
  gap: 1.1rem;
  max-width: 820px;
}
.bio-text p {
  font-size: 1.02rem;
  color: var(--color-text);
}
.project-preview,
.focus-section .container {
  border-top: 1px solid var(--color-border);
  padding-top: 3.25rem;
}
.preview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}
.focus-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
}
.focus-card {
  min-height: 180px;
  padding: 1.1rem 1.05rem;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  background: var(--color-surface);
  box-shadow: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.focus-card h3 {
  font-size: 1rem;
  line-height: 1.3;
}
.focus-card p {
  color: var(--color-muted);
  font-size: 0.9rem;
  line-height: 1.55;
}
.section-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.8rem;
}
.section-hdr .section-title {
  margin-bottom: 0;
}
.more-link {
  font-family: var(--font-sans);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--color-accent);
  transition: color 0.15s;
}
.more-link:hover { color: var(--color-secondary); }
.skills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}
.exp-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.exp-card {
  display: grid;
  grid-template-columns: 170px 1fr;
  gap: 1.5rem;
  padding: 1.35rem 1.5rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 4px;
  box-shadow: none;
}
.exp-period {
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--color-accent);
  display: block;
  padding-top: 0.25rem;
  text-transform: uppercase;
}
.exp-role {
  font-size: 1.05rem;
  margin-bottom: 0.2rem;
}
.exp-org {
  font-family: var(--font-sans);
  font-size: 0.92rem;
  font-weight: 650;
  color: var(--color-muted);
  margin-bottom: 0.7rem;
}
.exp-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.exp-bullets li {
  color: var(--color-muted);
  font-size: 0.94rem;
  line-height: 1.6;
  padding-left: 1rem;
  position: relative;
}
.exp-bullets li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.72em;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-accent);
}
@media (max-width: 900px) {
  .hero-grid,
  .about-grid,
  .exp-card {
    grid-template-columns: 1fr;
  }
  .preview-grid,
  .focus-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 560px) {
  .hero {
    padding-top: 3.4rem;
  }
  .preview-grid,
  .focus-grid {
    grid-template-columns: 1fr;
  }
  .snapshot-item {
    grid-template-columns: 1fr;
    gap: 0.1rem;
    padding: 0.35rem 0;
  }
  .section-hdr {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
