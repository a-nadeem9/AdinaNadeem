---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const sorted = all.sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter(p => p.data.featured);
const others = sorted.filter(p => !p.data.featured);
---

<Layout title="Projects - Adina Nadeem" description="Bioinformatics workflows and data projects by Adina Nadeem.">
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Work</p>
      <h1>Projects <span class="accent">.</span></h1>
      <p class="page-sub">
        Reproducible workflows for genomics, metagenomics, transcript quantification, and biomedical data analysis.
      </p>
    </div>

    {featured.length > 0 && (
      <section class="proj-section">
        <h2 class="section-title">Featured</h2>
        <div class="proj-list">
          {featured.map(p => (
            <ProjectCard title={p.data.title} description={p.data.description}
              tags={p.data.tags} github={p.data.github} demo={p.data.demo} featured={p.data.featured} />
          ))}
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="proj-section">
        <h2 class="section-title">Other Projects</h2>
        <div class="proj-list">
          {others.map(p => (
            <ProjectCard title={p.data.title} description={p.data.description}
              tags={p.data.tags} github={p.data.github} demo={p.data.demo} featured={p.data.featured} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
.page-header {
  padding: 3.6rem 0 2.4rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 2.5rem;
}
.eyebrow {
  font-family: var(--font-sans);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin-bottom: 1rem;
}
.page-header h1 { margin-bottom: 0.7rem; }
.page-sub {
  max-width: 760px;
  font-size: 1.02rem;
  color: var(--color-muted);
}
.proj-section { margin-bottom: 3.2rem; }
.proj-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  padding-bottom: 1rem;
}
@media (max-width: 760px) {
  .proj-list { grid-template-columns: 1fr; }
}
</style>
