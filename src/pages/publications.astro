---
import Layout from '../layouts/Layout.astro';

const researchThreads = [
  {
    title: 'Genomics and Infection Biology',
    text: 'Developing research experience around computational analysis in an infection biology environment, with emphasis on reproducible workflows and biological interpretation.',
  },
  {
    title: 'Reproducible Workflows',
    text: 'Interested in pipeline design, quality control, documentation, and reporting practices that make biomedical analysis easier to audit and extend.',
  },
  {
    title: 'Biomedical Data Integration',
    text: 'Long-term interest in connecting genomic, clinical, and environmental data responsibly for precision medicine research.',
  },
];
---

<Layout title="Research - Adina Nadeem" description="Research interests and direction of Adina Nadeem.">
  <div class="container">
    <div class="page-header">
      <div class="page-copy">
        <p class="eyebrow">Research Direction</p>
        <h1>Research <span class="accent">.</span></h1>
        <p class="page-sub">
          I am still early in my publication journey, so this page frames the questions I am building toward.
        </p>
      </div>
    </div>

    <section class="research-grid">
      {researchThreads.map(item => (
        <article class="research-card will-animate">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

  </div>
</Layout>

<style>
.page-header {
  padding: 3.6rem 0 2.4rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 2.5rem;
}
.page-copy {
  max-width: 760px;
}
.eyebrow {
  font-family: var(--font-sans);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin-bottom: 1rem;
}
.page-header h1 { margin-bottom: 0.7rem; }
.page-sub {
  max-width: 760px;
  font-size: 1.02rem;
  color: var(--color-muted);
}
.research-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  padding-bottom: 3.2rem;
}
.research-card {
  min-height: 0;
  padding: 1.25rem 1.35rem;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  background: var(--color-surface);
  box-shadow: none;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.research-card h2 {
  font-size: 1.12rem;
  line-height: 1.3;
}
.research-card p {
  color: var(--color-muted);
  font-size: 0.96rem;
  line-height: 1.7;
}
@media (max-width: 850px) {
  .research-grid { grid-template-columns: 1fr; }
}
</style>
